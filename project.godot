; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Water Race Ocean Lab"
run/main_scene="res://lab/lab_main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

SimulationClock="*res://ocean_v3/core/simulation_clock.gd"
OceanQualitySettings="*res://ocean_v3/core/ocean_quality_settings.gd"
OceanModuleRegistry="*res://ocean_v3/core/ocean_module_registry.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/ocean_v3_tools/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

rendering_device/driver.windows="d3d12"
lights_and_shadows/use_physical_light_units=true

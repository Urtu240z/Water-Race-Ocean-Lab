#!/usr/bin/env python
# SConstruct para la GDExtension OceanQuery (Fase 2C).
# Requiere godot-cpp en ../godot-cpp (offline) y SCons.
# Uso: python -m SCons platform=windows target=template_release
#
# El descriptor ACTIVO (water_race_ocean_query.gdextension) se genera a partir
# del template SOLO si la librería se compila correctamente. Si el build falla,
# no se crea el descriptor activo (Godot no intenta cargar una DLL inexistente).

env = SConscript("../godot-cpp/SConstruct", {"api_version": "4.7"})

# Sólo nuestros includes; godot-cpp ya configura include/core y include/gen.
env.Append(CPPPATH=["src/"])

# Binario de producción NATIVE DIRECT. Mantener la lista explícita evita que
# prototipos standalone (p. ej. OceanQueryPatchCore de 2C.1A) entren en la DLL
# por accidente al aparecer bajo src/. El benchmark PATCH los compila sólo con
# bench/build_bench_patch.bat.
sources = [
    "src/ocean_query_core.cpp",
    "src/ocean_query_native.cpp",
    "src/register_types.cpp",
]

# Nombre canónico de godot-cpp: <base><suffix><SHLIBSUFFIX>, p. ej.
# water_race_ocean_query.windows.template_release.x86_64.dll
library = env.SharedLibrary(
    "bin/water_race_ocean_query{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    source=sources,
)
env.NoCache(library)

# Genera el descriptor activo sólo tras compilar la librería.
descriptor = env.Command(
    "water_race_ocean_query.gdextension",
    ["water_race_ocean_query.gdextension.template", library],
    Copy("$TARGET", "${SOURCES[0]}"),
)

Default(library, descriptor)
